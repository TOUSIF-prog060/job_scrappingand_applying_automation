# Backend
PORT=3001

# Greenhouse board token (the part after boards.greenhouse.io/ in the URL)
GREENHOUSE_BOARD_TOKEN=notion

# Max jobs to import per scrape run
MAX_JOBS=15

# Automation: set to "true" to show browser window (useful for debugging)
HEADLESS=false

# Concurrency for apply-all (keep low to avoid bot detection)
MAX_CONCURRENCY=1
